#!/usr/bin/env bash
# Stops the cmatrix overlay. Leaves picom running (it's harmless/invisible
# for normal desktop use) unless --all is passed, which also kills picom.
pkill -f "cmatrix-overlay-setup.py" 2>/dev/null
pkill -f "matrix-rain.py" 2>/dev/null && echo "Overlay stopped." || echo "No overlay was running."

if [[ "${1:-}" == "--all" ]]; then
    pkill -x picom 2>/dev/null && echo "picom stopped." || true
fi
